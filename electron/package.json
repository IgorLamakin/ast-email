{
  "name": "ast-email-templates",
  "version": "2.5.6",
  "description": "АСТ Email Templates Desktop App",
  "author": "Igor Lamakin <308790231+IgorLamakin@users.noreply.github.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "ru.ast.email-templates",
    "productName": "AST Email Templates",
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "main.js",
      "wizard.html",
      "splash.html",
      "update.html",
      "RELEASE_NOTES.md",
      "preload.js",
      "icon.png",
      "icon.ico",
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!__pycache__",
          "!*.pyc",
          "!app.db",
          "!tests",
          "!tests/**",
          "!requirements-dev.txt",
          "!email_templates/files",
          "!email_templates/files/**"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "IgorLamakin",
      "repo": "ast-email",
      "private": true,
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseNotesFile": "RELEASE_NOTES.md"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  }
}

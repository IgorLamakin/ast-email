# Зависимости - устанавливаются заново командой npm install / pip install,
# незачем хранить в истории версий (десятки тысяч файлов, сотни МБ).
frontend/node_modules/
electron/node_modules/
backend/venv/

# Собранные артефакты - генерируются заново при каждой сборке.
frontend/dist/
dist-electron/

# Установщики всех версий - хранятся отдельно в releases/, тоже не в Git
# (это большие бинарные файлы, Git для них не предназначен; сама папка
# releases/ - это и есть наш "архив версий" на уровне готовых установщиков).
releases/

# Данные конкретного локального запуска для разработки - у каждого разработчика
# или машины они свои, в общую историю проекта не должны попадать.
backend/app.db
backend/uploads/
backend/*.log
backend/__pycache__/
**/__pycache__/
*.pyc

# Реальный пароль SMTP пишется прямо в этот файл (см. smtp-config.example.bat -
# это шаблон, который и хранится в Git). Никогда не коммитить smtp-config.bat.
smtp-config.bat

# Служебные временные файлы release.bat/get-release-info.js - существуют только
# в момент между генерацией и удалением внутри самого release.bat, коммититься
# не должны (без этой строки git add -A успевает подхватить их до удаления).
scripts/*.tmp

# Системные файлы
.DS_Store
Thumbs.db
